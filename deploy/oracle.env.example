# Install as /etc/option-trading-bot.env, owner optionbot, mode 600.
# Supply credentials locally on the VM. Do not commit this filled file.
BOT_MODE=paper
MARKET_DATA_PROVIDER=angel
STRATEGY=orb
BOT_AUTO_START=true
BOT_HOST=127.0.0.1
BOT_PORT=8765
BOT_DB_PATH=/var/lib/option-trading-bot/paper-costs-v2.sqlite3
STARTING_CAPITAL=25000
MAX_PREMIUM_PER_TRADE=12500
MAX_LOSS_PER_TRADE=500
MAX_DAILY_LOSS=1000
MAX_TRADES_PER_DAY=2
COOLDOWN_MINUTES=30
PAPER_FEE_MODEL=angel_nse_2026_10
PAPER_FEE_PER_ORDER=20
PAPER_SLIPPAGE_BPS=5
REVIEWER_ENABLED=false
LIVE_TRADING_ENABLED=false
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
# Optional scheduled Angel re-login in minutes (0 = off). Each login logs out other programs on this API key.
ANGEL_SESSION_REFRESH_MINUTES=0
# Generate locally: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
BOT_CONTROL_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

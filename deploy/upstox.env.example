# Upstox cloud paper profile. Install as /etc/option-trading-bot.env, owner optionbot, mode 600.
# Supply credentials locally on the VM. Do not commit this filled file.
BOT_MODE=paper
MARKET_DATA_PROVIDER=upstox
STRATEGY=orb
BOT_AUTO_START=true
BOT_HOST=127.0.0.1
BOT_PORT=8765
# A new database: provider and policy are recorded per database, so Angel history cannot be reused.
BOT_DB_PATH=/var/lib/option-trading-bot/upstox-orb-25k.sqlite3
STARTING_CAPITAL=25000
MAX_PREMIUM_PER_TRADE=12500
MAX_LOSS_PER_TRADE=500
MAX_DAILY_LOSS=1000
MAX_TRADES_PER_DAY=2
COOLDOWN_MINUTES=30
# Exit-check cadence while holding: one NIFTY + held-option full quote per cycle.
HELD_POLL_SECONDS=3
PAPER_FEE_MODEL=upstox_nse_2026_10
PAPER_FEE_PER_ORDER=20
PAPER_SLIPPAGE_BPS=5
REVIEWER_ENABLED=false
LIVE_TRADING_ENABLED=false
# Read-only Analytics Token (about one year). It can read quotes and option chains but cannot place orders.
# Preflight rejects UPSTOX_PIN / UPSTOX_TOTP_SECRET in this paper profile; leave them unset.
UPSTOX_ACCESS_TOKEN=
# Generate locally: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
BOT_CONTROL_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

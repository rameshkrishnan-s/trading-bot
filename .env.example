# demo: generated prices and paper fills; paper: Upstox prices and paper fills;
# live: Upstox prices and exchange orders (requires explicit live gate below).
BOT_MODE=demo
MARKET_DATA_PROVIDER=upstox
BOT_AUTO_START=true
BOT_HOST=127.0.0.1
BOT_PORT=8765
BOT_DB_PATH=./data/desk.sqlite3

# Upstox trading tokens expire daily; read-only Analytics Tokens have their own lifetime.
UPSTOX_ACCESS_TOKEN=
UPSTOX_ALGO_NAME=
# Optional unattended token renewal. Treat PIN and TOTP seed as highly sensitive.
# When all three are present, this path takes precedence over UPSTOX_ACCESS_TOKEN.
UPSTOX_API_KEY=
UPSTOX_PIN=
UPSTOX_TOTP_SECRET=
LIVE_TRADING_ENABLED=false
LIVE_STATIC_IP_APPROVED=false
BOT_CONTROL_TOKEN=

# Angel One is supported for PAPER data only. Set MARKET_DATA_PROVIDER=angel.
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
# Optional: log in to Angel again every N minutes inside the running bot (0 = off; else 5–1440).
# WARNING: each login logs out any other program using the same Angel API key.
ANGEL_SESSION_REFRESH_MINUTES=0

# Risk budget is in INR. Orders are long options only.
STARTING_CAPITAL=25000
MAX_PREMIUM_PER_TRADE=12500
MAX_LOSS_PER_TRADE=500
MAX_DAILY_LOSS=1000
MAX_TRADES_PER_DAY=2
COOLDOWN_MINUTES=30
# Exit-check cadence while holding (Angel paper: one spot+option quote per cycle).
HELD_POLL_SECONDS=3
MAX_SPREAD_PCT=2.0
MIN_OPTION_OI=10000
MIN_DAYS_TO_EXPIRY=2
BROKER_ORDER_TICK=0.05
PAPER_FEE_PER_ORDER=20
# Existing experiments use legacy; for a NEW Angel paper database use angel_nse_2026_10.
PAPER_FEE_MODEL=legacy
PAPER_FEE_BPS=5
PAPER_SLIPPAGE_BPS=5

# orb (opening-range breakout) and noise (noise-area intraday momentum) are paper/demo only.
# EMA is retained for historical comparison. Each strategy needs its own BOT_DB_PATH.
STRATEGY=orb
# Optional display-only reviewer: antigravity uses the signed-in agy CLI.
# gemini uses GEMINI_API_KEY. Credentials never go to the UI.
REVIEWER_PROVIDER=antigravity
ANTIGRAVITY_COMMAND=agy
REVIEWER_ENABLED=false
GEMINI_API_KEY=
REVIEWER_MODEL=gemini-2.5-flash
REVIEWER_INTERVAL_SECONDS=900
